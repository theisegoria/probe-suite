#!/usr/bin/env python3
"""probe: three benchmarks you can run against your own models.

  ./probe doctor              what is installed, and what each benchmark needs
  ./probe selftest            prove every scorer discriminates, in one go
  ./probe knowledge --help    what a model knows about an API, and where it breaks
  ./probe mesh --help         procedural geometry it writes and renders itself
  ./probe jeep --help         drive a vehicle round a course under real physics

Every benchmark has a self-test that proves its scoring discriminates before
you spend a run on it. Start with `./probe doctor`.
"""

import os
import shutil
import subprocess
import sys

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, ROOT)

GREEN, RED, DIM, OFF = "\033[32m", "\033[31m", "\033[2m", "\033[0m"
if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
    GREEN = RED = DIM = OFF = ""


def _mark(ok):
    return (GREEN + "  yes" + OFF) if ok else (RED + "  no " + OFF)


def _try_import(name):
    try:
        __import__(name)
        return True
    except ImportError:
        return False


def _cxx_ok():
    cxx = os.environ.get("PROBE_CXX", "c++")
    if not shutil.which(cxx):
        return False, "%s not found" % cxx
    src = os.path.join(ROOT, ".probe-cxx-check.cpp")
    with open(src, "w", encoding="utf-8") as fh:
        fh.write('#include <print>\n#include <ranges>\nint main(){std::println("ok");}\n')
    exe = src + ".out"
    try:
        p = subprocess.run([cxx, "-std=c++23", src, "-o", exe],
                           capture_output=True, text=True, timeout=90)
        ok = p.returncode == 0
        detail = "%s, C++23 accepted" % cxx if ok else (p.stderr.strip().splitlines() or ["failed"])[-1]
    except Exception as e:
        ok, detail = False, str(e)
    finally:
        for f in (src, exe):
            try:
                os.remove(f)
            except OSError:
                pass
    return ok, detail


def _physx_libs():
    for base in (os.path.join(ROOT, "engines", "PhysX", "out-mac-arm64", "bin"),
                 os.path.join(ROOT, "engines", "PhysX", "physx", "bin")):
        for dirpath, _dirs, files in os.walk(base) if os.path.isdir(base) else []:
            if any(f.startswith("libPhysXVehicle") for f in files):
                return True, dirpath
    return False, "not built, see adaptors/physx-apple-silicon/build.sh"


def doctor(argv):
    print("\nprobe suite: what is here and what it needs\n")
    py_ok = sys.version_info >= (3, 8)
    yaml_ok = _try_import("yaml")
    pil_ok = _try_import("PIL")
    cxx_ok, cxx_detail = _cxx_ok()
    px_ok, px_detail = _physx_libs()

    rows = [
        ("python 3.8 or later", py_ok, "%d.%d.%d" % sys.version_info[:3]),
        ("pyyaml", yaml_ok, "reads the task files" if yaml_ok else "pip install pyyaml"),
        ("a C++23 compiler", cxx_ok, cxx_detail),
        ("pillow", pil_ok, "converts frames for feedback" if pil_ok
         else "optional: pip install pillow"),
        ("PhysX 5 libraries", px_ok, px_detail),
    ]
    for label, ok, detail in rows:
        print("  %s  %-22s %s%s%s" % (_mark(ok), label, DIM, detail, OFF))

    print("\n  benchmark        can you run it now")
    ready = [
        ("knowledge", py_ok and yaml_ok,
         "needs python and pyyaml" if not (py_ok and yaml_ok) else "yes"),
        ("mesh", py_ok and yaml_ok and cxx_ok,
         "needs a C++23 compiler" if not cxx_ok else "yes"),
        ("jeep", py_ok and yaml_ok and cxx_ok and px_ok,
         "needs a C++ compiler" if not cxx_ok else
         ("needs PhysX 5 built, see adaptors/physx-apple-silicon/" if not px_ok else "yes")),
    ]
    for name, ok, why in ready:
        print("  %s  %-14s %s%s%s" % (_mark(ok), name, DIM, why, OFF))

    print("""
  next
    ./probe selftest               prove all of the scoring, in one go
    ./probe knowledge generate     draw a fresh item set
""")
    return 0


def _delegate(module, argv):
    sys.argv = [module] + argv
    mod = __import__(module.replace("/", "."), fromlist=["main"])
    return mod.main() or 0


def knowledge(argv):
    if argv and argv[0] == "selftest":
        return _delegate("suite.selftest", argv[1:])
    if argv and argv[0] == "generate":
        return _delegate("suite.generate", argv[1:])
    if argv and argv[0] == "run":
        return _delegate("suite.run", argv[1:])
    if argv and argv[0] == "report":
        return _delegate("suite.report", argv[1:])
    if argv and argv[0] == "sources":
        return _delegate("suite.sources", argv[1:])
    print("usage: ./probe knowledge {selftest|generate|run|report|sources} [options]")
    return 2


def _run(module, args):
    """Delegate, but survive a module that reports by calling sys.exit."""
    try:
        return _delegate(module, args) or 0
    except SystemExit as e:
        code = e.code
        if code is None:
            return 0
        if isinstance(code, int):
            return code
        print(code)
        return 1


def selftest(argv):
    """Everything that can be proved without an API key or a model.

    Steps are chosen by what this machine can actually do. Skipping is
    reported, not silent: a suite that quietly ran three of five checks and
    said "passed" would be worse than one that failed. Pass
    --require key[,key] to turn a skip into a failure, which is what
    continuous integration wants: knowledge, tools, jeep-offline, mesh,
    jeep-live.
    """
    required = set()
    for i, a in enumerate(argv):
        if a == "--require" and i + 1 < len(argv):
            required |= {k.strip() for k in argv[i + 1].split(",") if k.strip()}
        elif a.startswith("--require="):
            required |= {k.strip() for k in a.split("=", 1)[1].split(",") if k.strip()}

    cxx_ok, cxx_detail = _cxx_ok()
    px_ok, _px_detail = _physx_libs()

    steps = [
        ("knowledge", "knowledge scoring", "suite.selftest"),
        ("tools", "harness tools", "harness.selftest_tools"),
        ("jeep-offline", "jeep ladder, offline", "harness.selftest_jeep_offline"),
    ]
    skipped = []
    if cxx_ok:
        steps.append(("mesh", "mesh ladder", "harness.selftest_mesh"))
    else:
        skipped.append(("mesh", "no working C++23 compiler (%s)" % cxx_detail))

    if cxx_ok and px_ok:
        steps.append(("jeep-live", "jeep ladder, live against PhysX", "harness.selftest_jeep"))
    elif not px_ok:
        skipped.append(("jeep-live", "PhysX 5 is not built here. The offline step "
                                     "scores recorded runs and covers every rung"))
    else:
        skipped.append(("jeep-live", "no compiler to build against PhysX"))

    unknown = required - {k for k, _, _ in steps} - {k for k, _ in skipped}
    if unknown:
        print("  no such self test: %s" % ", ".join(sorted(unknown)))
        return 2

    failed = []
    for key, label, module in steps:
        print("\n%s== %s%s" % (DIM, label, OFF))
        if _run(module, []):
            failed.append(label)

    print("\n%s" % ("-" * 58))
    missing = []
    for key, why in skipped:
        print("  %sskipped  %-13s %s%s" % (DIM, key, why, OFF))
        if key in required:
            missing.append(key)
    if missing:
        print("  REQUIRED but skipped: %s" % ", ".join(missing))
    if failed:
        print("  FAILED: %s" % ", ".join(failed))
    if failed or missing:
        return 1
    print("  %d self test(s) passed, %d skipped" % (len(steps), len(skipped)))
    return 0


def mesh(argv):
    if argv and argv[0] == "selftest":
        return _delegate("harness.selftest_mesh", argv[1:])
    if argv and argv[0] == "run":
        return _delegate("suite.mesh_loop", argv[1:])
    print("usage: ./probe mesh {selftest|run} [options]")
    return 2


def jeep(argv):
    if argv and argv[0] == "selftest":
        if "--offline" in argv:
            return _delegate("harness.selftest_jeep_offline",
                             [a for a in argv[1:] if a != "--offline"])
        return _delegate("harness.selftest_jeep", argv[1:])
    if argv and argv[0] == "run":
        return _delegate("suite.jeep_loop", argv[1:])
    print("usage: ./probe jeep {selftest [--offline]|run} [options]")
    return 2


COMMANDS = {"doctor": doctor, "selftest": selftest, "knowledge": knowledge,
            "mesh": mesh, "jeep": jeep}


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    cmd = COMMANDS.get(argv[0])
    if not cmd:
        print("unknown command %r\n" % argv[0])
        print(__doc__)
        return 2
    return cmd(argv[1:])


if __name__ == "__main__":
    sys.exit(main())
